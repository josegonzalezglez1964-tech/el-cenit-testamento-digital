model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  nombre           String?
  apellidos        String?
  dni              String?      @unique
  fechaNacimiento  DateTime?
  direccion        String?
  telefono         String?
  role             String       @default("TESTADOR")
  createdAt        DateTime     @default(now())
  testamentos      Testamento[]

  @@map("users")
}