generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Testamento {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Datos del testador (JSON para flexibilidad)
  datosIdentidad Json?
  
  // Herederos, bienes, disposiciones (JSON arrays)
  herederos     Json
  bienes        Json
  disposiciones Json
  
  // Estado y firma
  estado        String   @default("borrador")
  hashDocumento String?
  selloTiempo   String?
  blockchainTx  String?
  
  // Relación con usuario (para cuando tengamos auth real)
  userId        String?
  
  @@map("testamentos")
}