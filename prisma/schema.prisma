generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Testamento {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  datosIdentidad Json?
  herederos     Json
  bienes        Json
  disposiciones Json
  
  estado        String   @default("borrador")
  hashDocumento String?
  selloTiempo   String?
  blockchainTx  String?
  userId        String?
  
  @@map("testamentos")
}